{
  "name": "@oh-rn/react-native-lewin-screen-capture",
  "displayName": "@oh-rn/react-native-lewin-screen-capture",
  "version": "1.1.0",
  "description": "获取系统截屏事件与获取当前屏幕截屏",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "react-native": "./src/index.js",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LewinJun/react-native-lewin-screen-capture.git"
  },
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/LewinJun/react-native-lewin-screen-capture#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "harmony/"
  ],
  "scripts": {
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name lewin_screen_capture --cpp-output-path ./harmony/lewin_screen_capture/src/main/cpp/generated --ets-output-path ./harmony/lewin_screen_capture/src/main/ets/generated --turbo-modules-spec-paths ./src/specs/v1/NativeScreenCapture.ts"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-lewin-screen-capture",
    "autolinking": {
      "cmakeLibraryTargetName": "lewin_screen_capture",
      "ohPackageName": "@oh-rn/react-native-lewin-screen-capture",
      "etsPackageClassName": "LewinScreenCapturePackage",
      "cppPackageClassName": "LewinScreenCapturePackage"
    }
  }
}
